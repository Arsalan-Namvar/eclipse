# Eclipse interactive Bash. Scripts must not initialize the prompt or editor.
[[ $- == *i* ]] || return

# ble.sh's recommended two-phase startup: load first, attach last.
# blesh-git installs this file and its contrib integrations together.
[[ ! -r /usr/share/blesh/ble.sh ]] || source -- /usr/share/blesh/ble.sh --attach=none

HISTCONTROL=ignoreboth:erasedups
HISTSIZE=10000
HISTFILESIZE=20000
shopt -s histappend checkwinsize

# Add each path once, including when opening a nested shell.
for _matlab_bin in /usr/local/MATLAB/*/bin; do
    [[ -d $_matlab_bin ]] || continue
    case :$PATH: in
        *:"$_matlab_bin":*) ;;
        *) PATH="$_matlab_bin:$PATH" ;;
    esac
done
unset _matlab_bin
case :$PATH: in
    *:"$HOME/.local/bin":*) ;;
    *) PATH="$HOME/.local/bin:$PATH" ;;
esac
export PATH

for _editor in nvim vim; do
    if command -v "$_editor" >/dev/null 2>&1; then
        export EDITOR=$_editor VISUAL=$_editor
        break
    fi
done
unset _editor

if [[ ! ${BASH_COMPLETION_VERSINFO-} && -r /usr/share/bash-completion/bash_completion ]]; then
    source /usr/share/bash-completion/bash_completion
fi

# Generated by the installed OMP version; no provider account access required.
if command -v omp >/dev/null 2>&1; then
    eval "$(omp completions bash)"
fi

if command -v fnm >/dev/null 2>&1; then
    eval "$(fnm env --use-on-cd --shell bash)"
fi

# Use ble.sh's integration instead of fzf's competing Readline bindings.
if command -v fzf >/dev/null 2>&1; then
    if [[ ${BLE_VERSION-} ]]; then
        ble-import -d integration/fzf-completion
        ble-import -d integration/fzf-key-bindings
    else
        eval "$(fzf --bash)"
    fi
fi

if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init bash)"
fi

# Exit Yazi in the directory chosen there, including paths containing spaces.
y() {
    local tmp cwd status
    tmp=$(mktemp -t yazi-cwd.XXXXXX) || return
    yazi "$@" --cwd-file="$tmp"
    status=$?
    if cwd=$(cat -- "$tmp") && [[ -n $cwd && $cwd != "$PWD" ]]; then
        builtin cd -- "$cwd" || status=$?
    fi
    rm -f -- "$tmp"
    return "$status"
}

alias cls=clear

# Initialize Starship after ble.sh and the other prompt-hook consumers.
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init bash)"
fi

# Machine-specific overrides remain outside the repository.
[[ ! -r ~/.bashrc.local ]] || source ~/.bashrc.local

[[ ! ${BLE_VERSION-} ]] || ble-attach
